generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  account   Account?
}

model Account {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int
  user    User   @relation(fields: [userId], references: [id])
}
